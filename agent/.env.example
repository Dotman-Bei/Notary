# The agent's own key. Its address becomes the agent ID on NotaryRegistry.
# Use a dedicated, low-value key: never the deployer's, never a wallet that holds anything else.
PRIVATE_KEY=0x

# Passphrase for the encrypted receipt store (data/receipts.enc). It holds every unrevealed
# claim and nonce: lose it, or the store, and those receipts can never be revealed.
NOTARY_STORE_KEY=

# Defaults: BOT Chain mainnet and the deployed, verified registry.
# NOTARY_ADDRESS=0xf1098FBfAb8F3A629e01E1F3FcbeF295E840BDab
# NOTARY_RPC_URL=https://rpc.botchain.ai
# NOTARY_CHAIN_ID=677
# NOTARY_GAS_GWEI=20
# NOTARY_STORE=data/receipts.enc
